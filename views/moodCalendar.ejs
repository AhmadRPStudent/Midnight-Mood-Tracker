<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <title>Mood Calendar</title>
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
    <link
        href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.css"
        rel="stylesheet"
    >

</head>

<body class="bg-dark text-light">

    <%- include('partials/navbar') %>

    <div class="container mt-5">

        <h2 class="text-danger mb-4">
            Mood Calendar
        </h2>

        <div id="calendar" class="bg-light p-3 rounded"></div>

        <!-- Hidden mood data -->
        <div id="moodData" style="display:none;">

            <% moods.forEach(mood => { %>

                <div
                    class="mood-entry"
                    data-date="<%= mood.date %>"
                    data-mood="<%= mood.mood %>"
                    data-energy="<%= mood.energy %>"
                    data-comment="<%= mood.comment %>"
                ></div>

            <% }) %>

        </div>

        <a href="/moods" class="btn btn-secondary mt-4">
            Back to Entries
        </a>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>

    <script>

        // collect hidden mood elements
        const moodElements =
            document.querySelectorAll(".mood-entry");

        // convert to calendar events
        const calendarEvents = [];

        moodElements.forEach(entry => {

            const mood = entry.dataset.mood;

            let color = "gray";

            if (mood === "Happy") color = "green";
            if (mood === "Sad") color = "lightblue";
            if (mood === "Excited") color = "orange";
            if (mood === "Angry") color = "red";
            if (mood === "Relaxed") color = "purple";

            calendarEvents.push({

                title:
                    `${mood} | Energy: ${entry.dataset.energy}`,

                start: entry.dataset.date,

                color: color,

                extendedProps: {
                    comment: entry.dataset.comment
                }

            });

        });

        document.addEventListener("DOMContentLoaded", function () {

            const calendarEl =
                document.getElementById("calendar");

            const calendar =
                new FullCalendar.Calendar(calendarEl, {

                initialView: "dayGridMonth",

                events: calendarEvents,

                eventClick: function(info) {

                    alert(
                        `Mood: ${info.event.title}\n\n` +
                        `Comment: ${info.event.extendedProps.comment}`
                    );

                }

            });

            calendar.render();

        });

    </script>

</body>

</html>