<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="UTF-8">
    <title>Mood Entries</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

</head>

<body class="bg-dark text-light">

    <%- include('partials/navbar') %>

    <div class="container mt-5">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <h1 class="text-danger">
                Mood Entries
            </h1>

            <a href="/addMood" class="btn btn-danger">
                Add Mood
            </a>

            <a href="/moodCalendar" class="btn btn-danger">
                View Calendar
            </a>

            <form action="/moods" method="GET">

                <select name="mood" class="border-danger">
                    <option value="">All Moods</option>
                    <option value="Happy">Happy</option>
                    <option value="Sad">Sad</option>
                    <option value="Excited">Excited</option>
                    <option value="Angry">Angry</option>
                    <option value="Relaxed">Relaxed</option>
                </select>

                <input type="date" name="date" class="border-danger">

                <button type="submit" class="btn btn-secondary">
                    Filter
                </button>

            </form>

        </div>

        <div class="row">

            <% moods.forEach(mood => { %>

                <div class="col-md-4 mb-4">

                    <div class="card bg-black border border-danger text-light shadow-lg h-100">

                        <div class="card-body">

                            <h3 class="text-danger">
                                <%= mood.mood %>
                            </h3>

                            <p>
                                <strong>Date:</strong>
                                <%= mood.date %>
                            </p>

                            <p>
                                <strong>Energy:</strong>
                                <%= mood.energy %>
                            </p>

                            <p>
                                <%= mood.comment %>
                            </p>

                            <div class="d-flex gap-2">

                                <a
                                    href="/editMood/<%= mood.id %>"
                                    class="btn btn-danger"
                                >
                                    Edit
                                </a>

                                <form
                                    action="/deleteMood/<%= mood.id %>"
                                    method="POST"
                                >

                                    <button class="btn btn-outline-light">
                                        Delete
                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>

                </div>

            <% }) %>

        </div>

    </div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>