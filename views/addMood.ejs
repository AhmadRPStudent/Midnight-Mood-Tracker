<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="UTF-8">
    <title>Add Mood</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

</head>

<body class="bg-dark text-light">

    <%- include('partials/navbar') %>

    <div class="container mt-5">

        <div class="row justify-content-center">

            <div class="col-md-6">

                <div class="card bg-black border-danger text-light shadow-lg">

                    <div class="card-body">

                        <h2 class="text-center text-danger mb-4">
                            Add Mood
                        </h2>

                        <form action="/addMood" method="POST">

                            <div class="mb-3">

                                <label class="form-label">
                                    Date
                                </label>

                                <input
                                    type="date"
                                    name="date"
                                    class="form-control bg-dark text-light border-danger"
                                    required
                                >

                            </div>

                            <div class="mb-3">

                                <label class="form-label">
                                    Mood
                                </label>

                                <select
                                    name="mood"
                                    class="form-select bg-dark text-light border-danger"
                                    required
                                >

                                    <option>Happy</option>
                                    <option>Sad</option>
                                    <option>Angry</option>
                                    <option>Tired</option>
                                    <option>Excited</option>
                                    <option>Relaxed</option>

                                </select>

                            </div>

                            <div class="mb-3">

                                <label class="form-label">
                                    Energy Level
                                </label>

                                <input
                                    type="number"
                                    name="energy"
                                    min="1"
                                    max="10"
                                    class="form-control bg-dark text-light border-danger"
                                    required
                                >

                            </div>

                            <div class="mb-3">

                                <label class="form-label">
                                    Comment
                                </label>

                                <textarea
                                    name="comment"
                                    rows="4"
                                    class="form-control bg-dark text-light border-danger"
                                ></textarea>

                            </div>

                            <button class="btn btn-danger w-100">
                                Save Mood
                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>